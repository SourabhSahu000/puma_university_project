{
  "version": 2,
  "functions": {
    "api/index.py": {
      "includeFiles": "puma_university.db"
    }
  },
  "rewrites": [
    {
      "source": "/static/(.*)",
      "destination": "/static/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index?__vercel_path=$1"
    }
  ]
}
